  { label: "Обучение", value: "15 мин", desc: "И вы в деле", icon: Timer },
  { label: "Риск падения", value: "< 10%", desc: "Слушая гида", icon: ShieldCheck }
];

// 2. Базовый комплект экипировки
const GEAR = [
