                       className="text-xl md:text-2xl font-black text-white uppercase tracking-tight"
                    >
                       {analysisText}
                    </motion.h3>
                </div>
            )}

            {/* === VIEW 3: РЕЗУЛЬТАТЫ === */}
            {view === 'results' && (
               <div className="flex flex-col h-full overflow-hidden bg-slate-950">
