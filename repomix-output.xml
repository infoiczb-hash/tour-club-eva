                                </td>
                                <td className="p-5 font-bold text-slate-900 dark:text-white">
                                    {cat.title}
                                </td>
                                <td className="p-5">
                                    <span className="font-mono text-xs text-slate-800 dark:text-slate-800 bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded-md">
