                           initial={{ width: 0 }}
                           animate={{ width: `${progress}%` }}
                           transition={{ duration: 0.5, ease: "easeOut" }}
                        />
                     </div>
                  </div>

                  <motion.div
                     key={step}
                     initial={{ x: 20, opacity: 0 }}
                     animate={{ x: 0, opacity: 1 }}
                     exit={{ x: -20, opacity: 0 }}
                     className="flex-1"
                  >
                     <h3 id="modal-quiz-title" className="text-2xl md:text-3xl font-black text-white mb-3 tracking-tight">
