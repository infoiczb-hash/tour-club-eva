    alternates: {
      canonical: url,
      languages: {
        'ru': url,
        'ro': `${url}?lang=ro`,
        'en': `${url}?lang=en`,
      },
    },
    openGraph: {
      title: `${meta.title} | Турклуб «Эва»`,
      description: meta.description,
      url,
      siteName: 'Турклуб «Эва»',
