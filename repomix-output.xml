  useEffect(() => {
    async function loadGuides() {
      const list = await getGuides();
      setGuides(list);
    }
    loadGuides();
  }, []);

  // АВТО-SLUG: Если создаем новую статью, генерируем slug из заголовка на лету
  useEffect(() => {
