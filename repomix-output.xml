                        {doc.title || `Документ ${i + 1}`}
                      </span>
                    </div>
                  </div>
                  <Download size={16} className="text-slate-600 group-hover:text-teal-500 transition-colors shrink-0" aria-hidden="true" />
                </Link>
              ))}
            </div>
          ) : (
