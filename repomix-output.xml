                      </div>
                  </div>
                </div>
              );
            })}
          </div>

          <div className="lg:hidden lg:col-span-12 border-t border-white/5 pt-8 mt-4">
            {actionCardsContent}
          </div>
        </div>
      </div>
    </section>
  );
}
