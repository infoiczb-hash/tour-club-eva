      {/* Показываем Промо и Футер ТОЛЬКО если это НЕ страница тура и НЕ личный кабинет */}
      {!isTourPage && !isAccountPage && (
        <>
          {promo}
          {footer}
        </>
      )}
    </div>
  );
}
