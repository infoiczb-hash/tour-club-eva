                      {n.message}
                    </p>
                  </div>

                  {/* Индикатор непрочитанного */}
                  {isUnread && (
                    <div className="flex-shrink-0 w-2 h-2 mt-2 bg-teal-400 rounded-full shadow-[0_0_8px_rgba(45,212,191,0.6)]" />
                  )}
