    {/* 🌍 СЦЕНАРИЙ 4: INTERNATIONAL */}
      {paymentMethod === 'foreign' && (
        <div className="w-full bg-slate-900/80 border border-slate-700/50 rounded-2xl p-5 mb-6 text-left shadow-lg">
