          <a href={receiptUrl} target="_blank" rel="noreferrer" className="mt-2 flex items-center gap-1.5 text-xs text-emerald-500/70 hover:text-emerald-400 transition-colors">
            <Eye size={14} /> Посмотреть чек
          </a>
        )}
