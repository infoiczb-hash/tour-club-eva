                 <span className="text-2xl font-black text-slate-900">{receiptModal.booking.total_price} MDL</span>
              </div>
              <div className="flex gap-3">
                <button 
                  onClick={() => handleStatusChangeWithModalClose(receiptModal.booking!.id, 'rejected')}
