              );

              return n.link ? (
                <Link key={n.id} href={n.link} className="block group">
                  {content}
                </Link>
              ) : (
                <div key={n.id}>{content}</div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
}
