const CRON_SECRET = process.env.CRON_SECRET || 'test-cron-secret';

function makeRequest(url: string, withAuth = true): Request {
  return new Request(url, {
    method: 'GET',
    headers: withAuth ? { authorization: `Bearer ${CRON_SECRET}` } : {},
  });
}

