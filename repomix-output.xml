            onClick={(e) => { e.stopPropagation(); onClose(); }} 
            className="text-slate-800 hover:text-slate-800 dark:hover:text-slate-800 transition p-1 hover:bg-slate-100 rounded-lg"
          >
            <X size={24} />
          </button>
