      {/* ========================================== */}
      {/* РЕЖИМ 2: ГРУППЫ (МАНИФЕСТ) - переделан на серверные пропсы */}
      {/* ========================================== */}
      {activeMode === 'groups' && (
        <div className="space-y-4 animate-in slide-in-from-right-4 duration-300">
