@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* --- ДИЗАЙН СИСТЕМА 2026 --- */
    --background: 210 40% 98%; /* slate-50 */
    --foreground: 222.2 84% 4.9%; /* slate-950 */
    
