          </h2>
          <div 
            className="text-slate-300 leading-relaxed text-base md:text-lg space-y-4"
           dangerouslySetInnerHTML={{ 
  __html: sanitizeHtml(tour.description, {
    allowedTags: sanitizeHtml.defaults.allowedTags.concat([ 'h1', 'h2', 'img', 'span' ]),
    allowedAttributes: {
      '*': ['class', 'style'],
