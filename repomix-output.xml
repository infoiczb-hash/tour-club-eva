                           <div className="text-[10px] text-slate-400 font-bold mt-1.5 flex items-center gap-1">
                             <Clock size={10} /> {new Date(post.scheduledFor).toLocaleString('ru-RU', {day: 'numeric', month: 'short', hour: '2-digit', minute:'2-digit'})}
