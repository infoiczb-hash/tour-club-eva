        {/* === VIEW 1: ВОПРОСЫ === */}
        {view === 'question' && (
           <div className="p-6 md:p-10 flex flex-col h-full overflow-y-auto custom-scrollbar">
              
              <div className="mb-8">
                 <div className="flex justify-between text-xs font-bold text-slate-300 uppercase tracking-widest mb-2">
