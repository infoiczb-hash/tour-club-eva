                 <Button type="button" variant="secondary" className="bg-white dark:bg-pink-950/50 border-none shadow-sm h-9 text-[12px] flex-1" onClick={async () => {
                     // Двойное приведение типа для обхода строгой проверки TS:
                     const res = (await performAiTask({ mode: 'smm_post', context: JSON.stringify(formData), platform: 'telegram' })) as any;
                     
                     if (res.success) {
                         const data = res.data as unknown as { caption: string; slides: { title: string; text: string }[]; hashtags: string[] };
                         // Заменили data.text на data.caption
                         const finalPost = `${data.caption}\n\n${data.hashtags.map(h => `#${h}`).join(' ')}`;
                         navigator.clipboard.writeText(finalPost).then(() => alert('✅ Copied!'));
                     } else {
                         alert('Error: ' + res.error);
                     }
                 }}><Send size={14} className="mr-2 text-sky-500"/> Telegram</Button>
