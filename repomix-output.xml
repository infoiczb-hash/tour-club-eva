                                   <button onClick={() => setDeleteConfirmHistoryId(null)} className="p-2 bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg hover:bg-slate-300 dark:hover:bg-slate-600"><X size={16}/></button>
