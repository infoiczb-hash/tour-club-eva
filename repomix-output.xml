            <div 
                ref={containerRef}
                className="flex-1 overflow-y-auto snap-y snap-mandatory scroll-smooth no-scrollbar"
                style={{ scrollBehavior: 'smooth' }}
            >
                {posts.map((post) => (
                    <SingleSlide key={post.id} post={post} />
