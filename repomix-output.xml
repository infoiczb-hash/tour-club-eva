// ─── Types & Data (Оставил твои без изменений) ───────────────────────────────
type TypeKey = "leader" | "keeper" | "analyst" | "explorer" | "soloist" | "adapter";
type Step = "intro" | "test" | "result";

interface Statement { id: number; text: string; type: TypeKey; }
interface ProfileType { key: TypeKey; name: string; tagline: string; icon: React.ReactNode; color: string; colorDim: string; accent: string; desc: string; blind: string; pair: string; }

const STATEMENTS: Statement[] = [
