  const [view, setView] = useState<'question' | 'analyzing' | 'result'>('question');
  const [finalResult, setFinalResult] = useState<Result | null>(null);

  useEffect(() => {
    if (open) {
      document.body.style.overflow = 'hidden';
      setStep(0);
      setAnswers([]);
      setView('question');
      setFinalResult(null);
    } else {
      document.body.style.overflow = '';
