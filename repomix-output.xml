                                    <p className="text-xs md:text-sm text-rose-200/80 font-medium leading-relaxed">
                                        {section.alert}
                                    </p>
                                </div>
                            )}
                        </div>
                    </motion.div>
                    )}
                </AnimatePresence>
                </motion.div>
            );
          })}
        </div>

      </div>
    </section>
  );
}
