                           post.platform === 'facebook' ? 'bg-blue-50 text-blue-600 dark:bg-blue-600/10 dark:text-blue-400' :
                           post.platform === 'threads' ? 'bg-slate-100 text-slate-900 dark:bg-slate-800 dark:text-white' :
