                     const res = (await performAiTask({ mode: 'smm_post', context: JSON.stringify(formData), platform: 'instagram' })) as any;
                     
                     if (res.success) {
                         const data = res.data as unknown as { caption: string; slides: { title: string; text: string }[]; hashtags: string[] };
