   ЭКРАН РЕЗУЛЬТАТА
======================= */
function ResultScreen({ result, onComplete, theme }: { result: Result; onComplete: (res: string) => void; theme: any }) {
  const ResultIcon = result.icon;

  return (
    <motion.div 
        initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }}
