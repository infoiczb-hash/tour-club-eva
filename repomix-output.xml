                            <TourCard key={tour.id} tour={tour} isHot priority={index === 0} />
                        ))}
                    </div>
                </section>
            )}

            {/* COMING SOON SECTION */}
            {displaySoon.length > 0 && (
                <section aria-labelledby="soon-tours-heading">
