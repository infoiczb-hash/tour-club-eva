    @apply bg-black/40 backdrop-blur-md border border-white/10;
  }
  
  .text-balance {
    text-wrap: balance;
  }

  /* ==========================================
     HERO ANIMATIONS
     Принцип: LCP-элементы не должны начинаться с opacity: 0.
     tailwindcss-animate (animate-in fade-in) стартует с opacity: 0 — это ломает LCP.
     Эти классы используют только transform (composited) или opacity > 0.
     ========================================== */

  /* LCP-заголовок «ЭВА» — только scale, opacity = 1 с первого кадра */
  .animate-hero-title {
    animation: hero-title-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* «Турклуб» — translateY + opacity от 0.01 (не 0!), небольшая задержка */
  .animate-hero-subtitle {
    animation: hero-subtitle-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 50ms;
  }
}

