                          backgroundColor: i < selected.length ? "#3b82f6" : "#1e293b",
                          scale: i < selected.length ? 1.1 : 1 
                        }}
                        className="w-3 h-3 rounded-full" 
                      />
                    ))}
                  </div>
              </div>

