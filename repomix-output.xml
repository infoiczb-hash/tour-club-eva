const VerticalPlayer = ({ 
    posts, 
    initialIndex, 
    onClose 
}: { 
    posts: SocialPost[], 
    initialIndex: number, 
    onClose: () => void 
}) => {
    const containerRef = useRef<HTMLDivElement>(null);

