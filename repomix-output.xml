          </div>

          {/* ПРАВАЯ КОЛОНКА */}
          <div className="lg:col-span-4 space-y-8">
            
            {stats.length > 0 && (
              <div className="bg-slate-900/50 backdrop-blur-md border border-white/5 p-8 rounded-[2rem] shadow-xl">
