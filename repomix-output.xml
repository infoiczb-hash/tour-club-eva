                   <p className="text-xs text-slate-500 flex items-center gap-1">
  <Users size={12}/> 
  {/* Проверяем: это объект? не null? есть имя? */}
  {(typeof tour.guide === 'object' && tour.guide?.name) 
    ? tour.guide.name 
    : "Без гида"
  }
</p>
