                    ref={playerView.ref}
                    style={{ opacity: playerView.inView ? 1 : 0, transform: playerView.inView ? 'scale(1)' : 'scale(0.95)', transition: 'opacity 0.6s ease-out, transform 0.6s ease-out' }}
