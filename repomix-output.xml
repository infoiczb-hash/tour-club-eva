                                <button onClick={onClose} className="text-violet-400 font-bold uppercase text-xs tracking-widest hover:text-white transition-colors">Закрыть</button>
                            </div>
                        )}
                    </div>
                )}
            </motion.div>
          )}

        </motion.div>
      </motion.div>
    </AnimatePresence>
  );
}
