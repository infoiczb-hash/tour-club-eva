import { z } from 'zod';

/// ✅ ПОМОЩНИК: JSON Helper
const jsonHelper = z.any() 
  .nullable()
  .optional()
  .transform((val) => {
    if (!val) return []; 
    if (typeof val === 'string') {
      try { 
        const parsed = JSON.parse(val);
        return parsed === null ? [] : parsed;
      } catch { 
        return []; 
      }
    }
    return val; 
  });

