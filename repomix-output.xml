import Link from "next/link";
import {
  ChevronLeft, RotateCcw, Mountain, Users, Search, 
  Compass, TreePine, Zap, ArrowRight, BookOpen, X,
  Clock, BarChart2, Sparkles, CheckCircle2, Brain
} from "lucide-react";
import { clsx } from "clsx";
