  const displayGuides = Array.isArray(guides) 
    ? [...guides].sort((a, b) => (a.order || 0) - (b.order || 0)) 
    : [];

  return (
 <section className="py-12 md:py-24 bg-slate-950 text-white relative overflow-hidden" id="team">
      
