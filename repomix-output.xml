  let imageUrl = guide.actionImage || guide.image || `${BASE_URL}/og-default.jpg`;
  if (imageUrl.startsWith('/')) imageUrl = `${BASE_URL}${imageUrl}`;

  return {
    title: `Гид ${guide.name} — туры, походы, биография | Турклуб Эва`,
