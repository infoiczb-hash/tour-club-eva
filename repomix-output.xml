                            finalResult.buttonClass
                          )}
                        >
                          Выбрать маршрут <ArrowRight size={16} />
                        </Link>
                      </div>
                    </div>
                  </motion.div>
              )}
            </AnimatePresence>
        </motion.div>
      </motion.div>
    </AnimatePresence>
  );
}
