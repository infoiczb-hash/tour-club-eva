              <div className="col-span-6 md:col-span-3">
                <FormInput 
                  name={`dates.${index}.start`} 
                  label={index === 0 ? "Старт" : ""} 
                  type="date" 
                />
              </div>
              
              <div className="col-span-6 md:col-span-3">
                <FormInput 
                  name={`dates.${index}.end`} 
                  label={index === 0 ? "Конец" : ""} 
