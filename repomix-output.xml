    bookingTour: tour,
    bookingInitialDate: date,
    bookingInitialDateId: dateId
  }),
  
  // Закрываем модалку бронирования
  closeBookingModal: () => set({
    isBookingOpen: false,
    bookingInitialDate: undefined,
    bookingInitialDateId: undefined
  })
}));
