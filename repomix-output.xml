];

/* =======================
   РЕЗУЛЬТАТЫ (МАТРИЦА НАПРАВЛЕНИЙ)
======================= */
const results: Result[] = [
  {
    id: "master",
    icon: Trophy,
    iconColor: "text-amber-400",
    title: "МАСТЕР УПАКОВКИ",
