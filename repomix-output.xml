  match: number;
  icon: React.ElementType;
  title: string;
  description: string;
  whyThis: string[];
  href_info: string;
  href_tours: string;
};

/* --- КОНСТАНТЫ ВОПРОСОВ (Только Lucide) --- */
const questions = [
  {
    id: 1,
    question: "Какой у вас опыт походов?",
    hint: "Подберем маршрут под ваш уровень подготовки",
