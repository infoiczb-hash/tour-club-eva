                       <button onClick={() => { setStep("intro"); setCurrent(0); setAnswers({}); }} className="w-full bg-white/5 hover:bg-white/10 text-white rounded-xl py-3.5 text-sm font-bold uppercase tracking-wider transition-colors">
                         Начать заново
                       </button>
                     </div>
                   </div>
                ) : (
                  <>
                    <p className="text-slate-300 text-sm leading-relaxed mb-6 font-medium">
