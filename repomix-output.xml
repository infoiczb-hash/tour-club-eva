import { toggleFunTestStatusAction } from "@/features/admin/actions/fun";
import { FunTest } from "@prisma/client";
import { clsx } from "clsx";
import { twMerge } from "tailwind-merge";

function cn(...inputs: (string | undefined | null | false)[]) {
