  closeContactModal: () => set({ 
    isContactOpen: false,
    contactContext: undefined 
  }),

  openQuizModal: () => set({ isQuizOpen: true }),
  closeQuizModal: () => set({ isQuizOpen: false }),

  // Открываем модалку бронирования и прокидываем тур + конкретную дату
