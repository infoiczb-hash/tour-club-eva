// ─── Types & Data ────────────────────────────────────────────────────────────
type TypeKey = "leader" | "keeper" | "analyst" | "explorer" | "soloist" | "adapter";
type Step = "intro" | "instruction" | "test" | "result";

interface Statement { id: number; text: string; type: TypeKey; }
interface ProfileType { 
