generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Blog {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug    String @unique
  title   String
  excerpt String
  content String

  category   String   @default("OTHER")
  categoryId String?  @map("category_id") @db.Uuid
  tags       String[] @default([])

  image        String?
  read_time    Int        @default(5)
  date         DateTime   @default(now()) @db.Timestamp(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  is_trending  Boolean    @default(false)
  format       PostFormat @default(long)
  author_name  String?    @default("Team Eva")
  author_role  String?    @default("Guide Club")
  author_image String?
  guideId      String?    @map("guide_id") @db.Uuid
  isActive     Boolean    @default(false) @map("is_active")

  guide        Guide?         @relation(fields: [guideId], references: [id])
  blogCategory BlogCategory?  @relation(fields: [categoryId], references: [id])
  favoritedBy  FavoritePost[] 
 
  @@index([isActive])
  @@index([categoryId])
  @@map("blog_posts")
}

model Tour {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String  @unique
  title       String
  subtitle    String?
  description String?
  categoryId  String? @map("category_id") @db.Uuid

  label     String  @default("")
  duration  String?
  location  String
  spots     Int     @default(15)
  spotsLeft Int     @default(15) @map("spots_left")
  currency  String  @default("RUB")

  gallery            String[] @default([])
  program            Json?    @default("[]")
  faq                Json?    @default("[]")
  included           String[] @default([])
  additionalExpenses String[] @default([]) @map("additional_expenses")
  documents          Json?    @default("[]")
  highlights         Json?    @default("[]")
  checklist          Json?    @default("[]")
  dates              Json     @default("[]")

  includedDetailed Json?   @map("included_detailed")
  excludedDetailed Json?   @map("excluded_detailed")
  tourFormat       String? @map("tour_format")
  accommodation    String?
  groupInfo        String? @map("group_info")
  importantInfo    String? @map("important_info")

  difficulty   String  @default("medium")
  distance     String?
  meetingPoint String? @map("meeting_point")
  route        String?

  price        Int     @default(0)
  priceOld     Int?    @map("price_old")
  priceChild   Int?    @map("price_child")
  priceFamily  Int?    @map("price_family")
  priceMember  Int?    @map("price_member")

  // ✅ ПРОВЕРЕНО И ОСТАВЛЕНО: ССЫЛКИ НА ОПЛАТУ
  biletpmrLink  String? @map("biletpmr_link") 
  apbQrLink     String? @map("apb_qr_link")   
  apbQrImage    String? @map("apb_qr_image")

  coverImage String?  @map("cover_image")
  metaDesc   String?  @map("meta_desc")
  metaTitle  String?  @map("meta_title")
  tags       String[] @default([])

  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  guideId  String?        @map("guide_id") @db.Uuid
  guide    Guide?         @relation(fields: [guideId], references: [id])
  category TourCategory?  @relation(fields: [categoryId], references: [id])

  bookings   Booking[]
  tourDates  TourDate[]
  waitlists  Waitlist[]
  reviews    Review[]
  watchLists WatchList[] 

  @@index([isActive])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("tours")
}

model TourDate {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tourId  String  @map("tour_id") @db.Uuid
  guideId String? @map("guide_id") @db.Uuid

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  time      String?
  meetingTime  String? @map("meeting_time")
  meetingPoint String? @map("meeting_point_override")
  
  // ✅ НОВОЕ ПОЛЕ: Секретный чат (v2.0)
  groupChatUrl String? @map("group_chat_url")
  
  spots     Int       @default(15)
  spotsLeft Int       @default(15) @map("spots_left")

  basePrice           Int? @map("base_price")
  discountEarlyBird   Int? @map("discount_early_bird")
  earlyBirdDeadline   Int? @map("early_bird_deadline")
  surchargeLastMinute Int? @map("surcharge_last_minute")
  lastMinuteTrigger   Int? @map("last_minute_trigger")

  status   String  @default("scheduled")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tour      Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  guide     Guide?     @relation(fields: [guideId], references: [id])
  bookings  Booking[]
  waitlists Waitlist[]

@@index([tourId])
  @@index([startDate])
  @@index([endDate, startDate])
  @@index([startDate, isActive])
  @@map("tour_dates")
}

model Booking {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  shortId     Int? @unique @map("short_id")

  memberId String?        @map("member_id") @db.Uuid
  member   MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  name   String
  phone  String
  email  String?
  social String?

  ticketsAdult  Int       @default(0) @map("tickets_adult")
  ticketsChild  Int       @default(0) @map("tickets_child")
  ticketsFamily Int       @default(0) @map("tickets_family")
  ticketsMember Int       @default(0) @map("tickets_member")

  guests        Json?     @default("[]")
  comment       String?

  totalPrice    Int       @map("total_price")
  amountPaid    Int       @default(0) @map("amount_paid")
  discount      Int       @default(0)
  paymentMethod String?   @map("payment_method")
  source        String    @default("website")

  status BookingStatus @default(pending)
  checkedIn   Boolean   @default(false) @map("checked_in")
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(6)
  bookedDate DateTime? @map("booked_date")

  tourId      String  @map("tour_id") @db.Uuid
  tourDateId  String? @map("tour_date_id") @db.Uuid
  promoCodeId String? @map("promo_code_id") @db.Uuid
  
  // ✅ НОВЫЕ ПОЛЯ: Модерация чеков и логи (v2.0)
  paymentProofUrl String?   @map("payment_proof_url") // Скриншот чека из TG бота
  receiptUrl      String?   @map("receipt_url")       // Официальный чек (если есть)
  confirmedBy     String?   @map("confirmed_by")      // Кто из админов проверил
  confirmedAt     DateTime? @map("confirmed_at")      // Когда проверили

  payerTgChatId   String? @map("payer_tg_chat_id")
  rejectReason    String? @map("reject_reason") 
 
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tour      Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tourDate  TourDate?  @relation(fields: [tourDateId], references: [id], onDelete: SetNull)
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

 @@index([tourId])
  @@index([status])
  @@index([memberId])
  @@index([shortId]) 
  @@index([phone, tourDateId])
  @@index([payerTgChatId])
  @@index([memberId, status])
  @@index([tourDateId, status])
  @@map("bookings")
}

model Waitlist {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tourId     String  @map("tour_id") @db.Uuid
  tourDateId String? @map("tour_date_id") @db.Uuid
  
  memberId   String? @map("member_id") @db.Uuid
  name       String
  phone      String?
  social     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tour       Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tourDate   TourDate?      @relation(fields: [tourDateId], references: [id], onDelete: Cascade)
  member     MemberProfile? @relation(fields: [memberId], references: [id], onDelete: Cascade) 

  @@index([tourId])
  @@index([tourDateId])
  @@index([memberId]) 
  @@index([phone])
  @@index([tourId, tourDateId])
  @@map("waitlists")
}

model PromoCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @unique
  discount    Int       @default(100) 
  type        String    @default("fixed") 
  validUntil  DateTime? @map("valid_until") @db.Timestamptz(6)
  usageCount  Int       @default(0) @map("usage_count")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reward      Int       @default(50)  
  memberId    String?   @unique @db.Uuid
  member      MemberProfile? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([code])
  @@map("promo_codes")
}

model TourCategory {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String  @unique
  title     String
  icon      String  @default("Compass")
  color     String  @default("teal")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  tours      Tour[]
  watchLists WatchList[] 

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tour_categories")
}

model BlogCategory {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String  @unique
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  posts Blog[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("blog_categories")
}

model Guide {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String? @unique @default(cuid())
  name String
  role String  @default("GID")

  image       String?
  actionImage String?

  bio          String?
  fullBio      String?
  quotes       String[]
  experience   String?
  superpower   String?
  tags         String[]
  achievements String[]

  stats Json?

  contact   String?
  instagram String?
  telegram  String?

  order    Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  posts     Blog[]
  tours     Tour[]
  tourDates TourDate[]
  watchLists WatchList[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("guides")
}

model ContentBlock {
  slug    String @id @unique
  content Json

  @@map("content_blocks")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String  
  text       String
  source     String   @default("tg") 
  avatar     String?
  category   String   @default("general")
  isActive   Boolean  @default(true) @map("is_active") 

  rating     Int?
  tags       String[] @default([]) 
  images     String[] @default([]) 

  tourId     String?  @map("tour_id") @db.Uuid
  tour       Tour?    @relation(fields: [tourId], references: [id], onDelete: SetNull)
  
  memberId   String?  @map("member_id") @db.Uuid
  member     MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([tourId]) 
  @@map("reviews")
}

model Inquiry {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type   InquiryType
  status InquiryStatus @default(NEW)
  name   String
  phone  String?
  social String?       @map("social_link")

  message String?
  payload Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([type])
  @@map("inquiries")
}

model FunTest {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  image       String?
  category    String  @default("general")
  isActive    Boolean @default(false)
  passCount   Int     @default(0)
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// ЛИЧНЫЙ КАБИНЕТ УЧАСТНИКА
// ─────────────────────────────────────────────

model MemberProfile {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String  @unique @map("user_id")
  phone      String? @unique
  name       String?
  email      String?
  avatarUrl  String? @map("avatar_url")
  telegram       String?
  tgChatId      String? @unique @map("tg_chat_id")
  instagram      String?
  viber          String?
  
  foodPref       String? @map("food_pref")
  shoeSize       String? @map("shoe_size")
  clothesSize    String? @map("clothes_size")
  lifeJacketSize String? @map("life_jacket_size")
  inventory      String[]  @default([])

  level      String  @default("Первопроходец")
  totalTours Int     @default(0) @map("total_tours")
  totalKm    Float   @default(0) @map("total_km")

  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookings      Booking[]
  watchLists    WatchList[]
  testResults   TestResult[]
  favoritePosts FavoritePost[] 
  waitlists     Waitlist[]     
  reviews       Review[]
  notifications Notification[]
  pushSubscriptions PushSubscription[] 

  balance       Int       @default(0) 
  role          String    @default("user")
  invitedByCode String?
  promoCode     PromoCode?
  tags          String[]  @default([])   // Сегментация: ["vip", "ambassador", "photographer"]
  balanceLogs   BalanceLog[]            // История изменений баланса

 @@index([phone])
  @@index([userId])
  @@index([level])
  @@index([totalTours])
  @@map("member_profiles")
}
// ✅ НОВАЯ ТАБЛИЦА: Центр Уведомлений / Логи (v2.0)
model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  member    MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type      String   @default("info") // info, booking, bonus, system
  title     String?
  message   String
  link      String?  // Ссылка для перехода (например, /account/bookings/123)
  
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

@@index([memberId, isRead])
  @@index([memberId, isRead, createdAt])
  @@map("notifications")
}

model WatchList {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  memberId String        @map("member_id") @db.Uuid
  member   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  tourId String? @map("tour_id") @db.Uuid
  tour   Tour?   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  categoryId String? @map("category_id") @db.Uuid
  category   TourCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  guideId String? @map("guide_id") @db.Uuid
  guide   Guide?  @relation(fields: [guideId], references: [id], onDelete: Cascade)

  notified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([memberId, tourId])
  @@unique([memberId, categoryId])
  @@unique([memberId, guideId])
  @@index([memberId])
  @@index([tourId])
  @@map("watch_list")
}

model FavoritePost {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  member    MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  post      Blog          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([memberId, postId])
  @@index([memberId])
  @@index([postId])
  @@map("favorite_posts")
}

model TestResult {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  memberId String        @map("member_id") @db.Uuid
  member   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  testSlug String @map("test_slug")
  result   Json 

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([memberId, testSlug])
  @@index([memberId])
  @@map("test_results")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  device    String?  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  member    MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("push_subscriptions")
}

model AdminLog {
  id        String    @id @default(uuid())
  actorType ActorType
  adminId   String?   // UUID админа, выполнившего действие (null если SYSTEM)
  adminName String?   // Денормализация для быстрого отображения в UI
  action    String    // Название действия, например: "UPDATE_TOUR", "CRON_SYNC"
  targetId  String?   // ID сущности, над которой произведено действие (опционально)
  changes   Json?     // Payload: переданные аргументы или diff
  ip        String?   // IP-адрес инициатора (null для CRON)
  userAgent String?   // User-Agent (null для CRON)
  createdAt DateTime  @default(now())

  @@index([action])
  @@index([targetId])
  @@index([adminId])
  @@index([createdAt])
}

model BalanceLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  member    MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount    Int      // +50 или -200
  reason    String   // "Отзыв за тур", "Оплата тура #123", "Ручное начисление"
  adminNote String?  @map("admin_note")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("balance_logs")
}

model ScheduledPost {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform      String    // 'telegram', 'instagram', 'facebook'
  format        String    @default("post") // 'post', 'story'
  content       String    // Готовый текст поста
  imageUrl      String?   @map("image_url") // Ссылка на готовую картинку
  status        String    @default("draft") // 'draft', 'scheduled', 'published', 'failed'
  scheduledFor  DateTime? @map("scheduled_for") @db.Timestamptz(6)
  
  sourceType    String    @map("source_type") // 'tour', 'blog', 'custom'
  sourceId      String?   @map("source_id") @db.Uuid
  sourceUrl     String?   @map("source_url")
  
  templateStyle String?   @map("template_style") // 'minimal', 'bright' и т.д.
  
  adminId       String?   @map("admin_id") @db.Uuid // Кто создал/запланировал
  errorMessage  String?   @map("error_message") // Ошибка при публикации
  metadata      Json?     // Хештеги, ID сообщения в ТГ и т.д.
  
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([scheduledFor])
  @@map("scheduled_posts")
}

model AiPrompt {
  id        String   @id @default(cuid())
  title     String
  prompt    String   @db.Text
  createdAt DateTime @default(now())

  @@map("ai_prompts")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum PostFormat {
  short
  long
}

enum BookingStatus {
  pending
  awaiting_payment
  moderation
  confirmed
  rejected
  cancelled
}

enum InquiryType {
  TOUR
  HR
  BLOG
  B2B
  REVIEW
  HELP
}

enum InquiryStatus {
  NEW
  WORK
  DONE
}

enum ActorType {
  ADMIN
  SYSTEM
}